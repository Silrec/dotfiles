#!/usr/bin/env bash
# Make Neovim follow Noctalia's active built-in palette.
set -u
read -r source name <<<"$(noctalia msg color-scheme-get)"
[[ $source == builtin ]] || exit 0

case "$name" in
"Tokyo-Night") nvim="tokyonight-night" star="tokyo_night" ;;
"Catppuccin") nvim="catppuccin-mocha" star="catppuccin_mocha" ;;
"Gruvbox") nvim="gruvbox" star="gruvbox" ;;
"Kanagawa") nvim="kanagawa" star="kanagawa" ;;
"Rosé Pine") nvim="rose-pine" star="rose_pine" ;;
"Nord") nvim="nord" star="nord" ;;
"Dracula") nvim="dracula" star="dracula" ;;
*) exit 0 ;;
esac

sed -i --follow-symlinks "s/^palette = .*/palette = \"$star\"/" ~/.config/starship.toml

echo "return \"$nvim\"" >~/.config/nvim/lua/current-theme.lua
for sock in "$XDG_RUNTIME_DIR"/nvim.*.0; do
  if [[ -S $sock ]]; then
    nvim --server "$sock" --remote-expr "execute('colorscheme $nvim')" >/dev/null 2>&1
  fi
done
