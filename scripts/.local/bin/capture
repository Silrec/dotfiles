#!/usr/bin/env bash
# capture: screenshots, OCR and screen recording for Hyprland + Noctalia
#   capture menu                     pick an action in Noctalia's launcher
#   capture region | screen | annotate | window | ocr | record | record-region
# Screenshots and the region overlay come from Noctalia (Settings → Screenshot
# decides copy/save and the folder); window shots, OCR text and recording are done here.
set -u

pics="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots" # keep equal to Noctalia's folder
vids="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Recordings"

stamp() { date +%Y-%m-%d_%H-%M-%S; }
notify() { notify-send -a capture "$@"; }
focused_output() { hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'; }
window_geom() { hyprctl activewindow -j | jq -r 'select(.at) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'; }
recording() { pgrep -x wf-recorder >/dev/null; }
# slurp styled close to Noctalia's overlay: dimmed screen, clear selection, light frame, size label
pick_region() { slurp -d -b 00000088 -s 00000000 -c ffffffcc -w 2; }

window_shot() {
  local g
  g=$(window_geom)
  [[ -n $g ]] || exit 0
  mkdir -p "$pics"
  local f="$pics/$(stamp).png"
  grim -g "$g" "$f" || exit 1
  wl-copy --type image/png <"$f"
  notify -i "$f" "Screenshot saved" "${f/#$HOME/\~} (copied to clipboard)"
}

ocr() {
  # Use Noctalia's overlay: empty the clipboard, let you copy a region, OCR that image
  wl-copy --clear
  noctalia msg screenshot-region
  local got=0
  for _ in {1..600}; do # wait up to 60 s for Ctrl+C / Enter in the overlay
    sleep 0.1
    if wl-paste --list-types 2>/dev/null | grep -qx 'image/png'; then
      got=1
      break
    fi
  done
  ((got)) || exit 0 # cancelled (Esc) or timed out

  local text
  text=$(wl-paste --type image/png | tesseract - - -l eng+rus 2>/dev/null)
  if [[ -z ${text//[[:space:]]/} ]]; then
    notify "OCR" "No text found"
    exit 0
  fi
  printf '%s' "$text" | wl-copy
  notify "Text copied" "$(printf '%s' "$text" | head -c 200)"
}

record() { # record [geometry]: starts, or stops if already running
  if recording; then
    pkill -INT -x wf-recorder # SIGINT lets it finish the file properly
    notify "Recording stopped" "Saved in ${vids/#$HOME/\~}"
    return
  fi
  mkdir -p "$vids"
  local f="$vids/$(stamp).mp4"
  local args=(-f "$f" -c h264_vaapi -d /dev/dri/renderD128 # GPU encoding; CPU fallback: -c libx264
    --audio="$(pactl get-default-sink).monitor")           # what you hear, not the microphone
  if [[ -n ${1:-} ]]; then args+=(-g "$1"); else args+=(-o "$(focused_output)"); fi
  wf-recorder "${args[@]}" >/dev/null 2>&1 &
  notify "Recording started" "Run capture again (menu or shortcut) to stop"
}

menu() {
  # Pressing the key again while the launcher is open closes it (same as keyhelp)
  if pgrep -f '^noctalia dmenu' >/dev/null; then
    noctalia msg panel-close
    exit 0
  fi

  local items
  if recording; then
    items=$'⏹️  Stop recording\tA recording is running'
  else
    items=$'📷  Screenshot region\tSelect an area\n'
    items+=$'🖥️  Screenshot screen\tCurrent monitor\n'
    items+=$'🪟  Screenshot window\tActive window\n'
    items+=$'✏️  Annotate\tFreeze the screen and draw on it\n'
    items+=$'🔤  OCR region\tRecognise text in an area → clipboard\n'
    items+=$'🎥  Record screen\tCurrent monitor, with system audio\n'
    items+=$'✂️  Record region\tSelected area, with system audio'
  fi

  local choice
  choice=$(printf '%s\n' "$items" | noctalia dmenu -p 'Capture') || exit 0
  choice=${choice%%$'\t'*} # the launcher returns the full line; keep the title
  sleep 0.3                # let the launcher fade out before capturing

  case $choice in
  *"Screenshot region") exec "$0" region ;;
  *"Screenshot screen") exec "$0" screen ;;
  *"Screenshot window") exec "$0" window ;;
  *"Annotate") exec "$0" annotate ;;
  *"OCR region") exec "$0" ocr ;;
  *"Record screen") exec "$0" record ;;
  *"Record region") exec "$0" record-region ;;
  *"Stop recording") exec "$0" record ;;
  esac
}

case ${1:-} in
menu) exec noctalia msg panel-toggle launcher "/cap " ;;
region) noctalia msg screenshot-region ;;
screen) noctalia msg screenshot-fullscreen monitor ;;
annotate) noctalia msg screenshot-annotate ;;
window) window_shot ;;
ocr) ocr ;;
record) record ;;
record-region) if recording; then record; else
  g=$(pick_region) || exit 0
  record "$g"
fi ;;
*)
  echo "usage: capture menu|region|screen|annotate|window|ocr|record|record-region" >&2
  exit 1
  ;;
esac
